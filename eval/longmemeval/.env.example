# LongMemEval local credentials
#
# Copy to one of:
# - eval/longmemeval/.env.local   ← preferred, benchmark-specific
# - .env.local                    ← shared repo-local fallback
#
# The runner auto-loads env files in this order:
# 1. eval/longmemeval/.env.local
# 2. eval/longmemeval/.env
# 3. .env.local
# 4. .env
#
# Exported shell variables still win because dotenv is loaded with override=false.

ENGRAM_API_BASE=http://localhost:3002
ENGRAM_API_KEY=
ANTHROPIC_API_KEY=
HUGGINGFACE_TOKEN=
LONGMEMEVAL_READ_MODEL=claude-opus-4-7
